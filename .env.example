# Local-only Aria admin/API key. Do not expose port 8001 to the internet.
ADMIN_API_KEY=replace-with-a-long-random-secret
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-secret

# Shared
APP_ENV=development
LOG_LEVEL=info
OTEL_ENABLED=false
OTEL_SERVICE_NAME=aria-agent-core
# Optional OTLP gRPC collector; leave empty to keep traces local-only.
OTEL_EXPORTER_OTLP_ENDPOINT=

# WhatsApp Gateway
WHATSAPP_PORT=3001
WHATSAPP_HOST=0.0.0.0
WHATSAPP_SESSION_DIR=.data/whatsapp-auth
WHATSAPP_WEBHOOK_URL=http://agent-core:8000/webhooks/whatsapp
WHATSAPP_API_KEY=change-me
# Shared between gateway -> agent webhook auth. If empty, the gateway key is used as fallback.
WHATSAPP_WEBHOOK_API_KEY=
WHATSAPP_AUTO_READ=true
WHATSAPP_ALLOWED_NUMBERS=919999999999,911234567890
WHATSAPP_ALLOWED_GROUP_IDS=1203630xxxxxxxx@g.us
WHATSAPP_ALLOWED_GROUP_NAMES=
WHATSAPP_PAIRING_NUMBER=

# Agent Core
AGENT_PORT=8000
AGENT_HOST=0.0.0.0
# Choose cli,web,telegram,whatsapp or all. The tools/aria launcher selects the WhatsApp Compose profile.
ARIA_CHANNELS=all
# The tools/aria launcher sets these from your login so generated workspace files remain editable.
# Set them to your host UID/GID if starting Compose directly (run: id -u; id -g).
ARIA_UID=1000
ARIA_GID=1000
GROQ_API_KEY=
# NVIDIA NIM hosted inference. Keep the real key only in your ignored local .env.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_SUPER_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_CODE_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_ROBOTICS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
MODEL_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:latest
OLLAMA_HOST=http://host.docker.internal:11434
# 4096 keeps local CPU/RAM use modest; raise to 131072 to request the model's full context.
OLLAMA_NUM_CTX=4096
GROQ_SIMPLE_MODEL=llama-3.1-8b-instant
GROQ_COMPLEX_MODEL=llama-3.3-70b-versatile
GROQ_COMPLEX_MESSAGE_LENGTH=280
GROQ_COMPLEX_HISTORY_THRESHOLD=6
AGENT_NAME=Aria
SYSTEM_PROMPT=You are a backend operations copilot. Keep responses concise, helpful, and action-oriented.
WHATSAPP_GATEWAY_URL=http://whatsapp-gateway:3001
WHATSAPP_GATEWAY_API_KEY=change-me
TELEGRAM_BOT_TOKEN=
# Numeric Telegram private-chat IDs allowed to use Aria and receive notifications.
TELEGRAM_ALLOWED_CHAT_IDS=
DEFAULT_REPLY_ENABLED=true
AGENT_DATA_DIR=.data/agent-core
ACCESS_POLICY_FILE=config/access-policy.json
MAX_HISTORY_MESSAGES=10
ENABLE_AUDIT_LOGGING=true
ENABLE_COMMANDS=true
