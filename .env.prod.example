# Aria Production Environment Configuration
# Copy this to .env and fill in your values

# ============================================
# Core Application
# ============================================
APP_ENV=production
LOG_LEVEL=info
ARIA_UID=1000
ARIA_GID=1000
AGENT_HOST=0.0.0.0
AGENT_PORT=8000
ARIA_CHANNELS=all

# ============================================
# Model Providers (choose one)
# ============================================
# Groq (recommended for production)
MODEL_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
GROQ_SIMPLE_MODEL=llama-3.1-8b-instant
GROQ_COMPLEX_MODEL=llama-3.3-70b-versatile

# Ollama (local)
# MODEL_PROVIDER=ollama
# OLLAMA_HOST=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.2:latest

# NVIDIA
# MODEL_PROVIDER=nvidia
# NVIDIA_API_KEY=your-nvidia-api-key
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ============================================
# WhatsApp Gateway
# ============================================
WHATSAPP_GATEWAY_URL=http://whatsapp-gateway:3001
WHATSAPP_GATEWAY_API_KEY=your-whatsapp-gateway-key
WHATSAPP_WEBHOOK_API_KEY=your-webhook-key
WHATSAPP_PORT=3001
WHATSAPP_HOST=0.0.0.0
WHATSAPP_SESSION_DIR=.data/whatsapp-auth
WHATSAPP_AUTO_READ=true
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_ALLOWED_GROUP_IDS=
WHATSAPP_ALLOWED_GROUP_NAMES=

# ============================================
# Telegram Bot
# ============================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ALLOWED_CHAT_IDS=your-chat-id

# ============================================
# Slack Bot
# ============================================
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token
SLACK_ALLOWED_CHANNELS=C123456,C789012

# ============================================
# Discord Bot
# ============================================
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_ALLOWED_CHANNELS=123456789,987654321

# ============================================
# Email Gateway
# ============================================
EMAIL_WEBHOOK_KEY=your-email-webhook-secret

# ============================================
# Security
# ============================================
ADMIN_API_KEY=replace-with-a-long-random-secret
MCP_IDENTITY=aria-production
MCP_ALLOWED_HOSTS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000,your-domain.com

# ============================================
# Redis/Valkey
# ============================================
REDIS_ENABLED=true
REDIS_URL=redis://valkey:6379/0

# ============================================
# Memory
# ============================================
SHORT_TERM_MEMORY_TURNS=4
SHORT_TERM_MEMORY_TTL_SECONDS=86400
LONG_TERM_MEMORY_DB_PATH=.data/agent-core/long_term_memory.sqlite3
LONG_TERM_MEMORY_TOP_K=5

# ============================================
# Attic (Durable Memory)
# ============================================
ATTIC_ENABLED=true
ATTIC_MCP_URL=http://host.docker.internal:4100/mcp
ATTIC_MCP_API_KEY=admin30

# ============================================
# Tools
# ============================================
TOOLS_DIR=tools
ENABLE_COMMANDS=true
ENABLE_AUDIT_LOGGING=true
MAX_HISTORY_MESSAGES=10

# ============================================
# Grafana
# ============================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-secret

# ============================================
# WhatsApp Gateway (separate service)
# ============================================
WHATSAPP_WEBHOOK_URL=http://agent-core:8000/webhooks/whatsapp
WHATSAPP_API_KEY=your-whatsapp-api-key
