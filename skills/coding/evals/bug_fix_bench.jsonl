{"task": "fix_off_by_one", "description": "Fix off-by-one error in loop", "files": {"src/buggy.py": "def process_items(items):\n    result = []\n    for i in range(len(items) + 1):\n        result.append(items[i] * 2)\n    return result"}, "expected_fix": "range(len(items))", "test": "assert process_items([1,2,3]) == [2,4,6]"}
{"task": "null_pointer", "description": "Handle None input gracefully", "files": {"src/handler.py": "def get_name(user):\n    return user.name.upper()"}, "expected_fix": "if user is None: return 'GUEST'", "test": "assert get_name(None) == 'GUEST'"}
{"task": "string_concat_perf", "description": "Optimize string concatenation in loop", "files": {"src/build.py": "def build_string(parts):\n    result = ''\n    for p in parts:\n        result += p\n    return result"}, "expected_fix": "''.join(parts)", "test": "assert build_string(['a','b']) == 'ab'"}
{"task": "dict_key_error", "description": "Safe dictionary access with default", "files": {"src/lookup.py": "def get_config(config, key):\n    return config[key]"}, "expected_fix": "config.get(key, 'default')", "test": "assert get_config({}, 'missing') == 'default'"}
{"task": "mutable_default_arg", "description": "Fix mutable default argument bug", "files": {"src/collect.py": "def add_item(item, items=[]):\n    items.append(item)\n    return items"}, "expected_fix": "items=None; items = items or []", "test": "assert add_item(1) == [1]; assert add_item(2) == [2]"}